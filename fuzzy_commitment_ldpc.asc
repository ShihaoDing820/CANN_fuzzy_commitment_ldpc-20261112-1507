#include <algorithm>
#include <array>
#include <bitset>
#include <cstdint>
#include <cstdlib>
#include <iomanip>
#include <iostream>
#include <random>
#include <stdexcept>
#include <string>
#include <vector>

#include "acl/acl.h"
#ifdef ASCENDC_CPU_DEBUG
#include "cpu_debug_launch.h"
#endif
#include "kernel_operator.h"

#include "fuzzy_commitment_crypto.h"

namespace {

constexpr int32_t kLiftSize = 16;
constexpr int32_t kBaseRows = 3;
constexpr int32_t kBaseColumns = 6;
constexpr int32_t kCheckCount = kBaseRows * kLiftSize;
constexpr int32_t kVariableCount = kBaseColumns * kLiftSize;
constexpr int32_t kCheckDegree = kBaseColumns;
constexpr int32_t kVariableDegree = kBaseRows;
constexpr int32_t kEdgeCount = kCheckCount * kCheckDegree;
constexpr int32_t kBatchSize = 10;
constexpr int32_t kMaxIterations = 30;
constexpr float kChannelLlr = 4.0F;
constexpr float kNormalization = 0.75F;

// A small, deterministic (3, 6)-regular QC-LDPC graph. Each entry is the
// cyclic shift of a 16x16 permutation block.
constexpr int32_t kBaseShifts[kBaseRows][kBaseColumns] = {
    {0, 0, 0, 0, 0, 0},
    {15, 13, 6, 1, 15, 5},
    {8, 14, 1, 1, 1, 5},
};

class FuzzyCommitmentLdpcKernel {
public:
    __aicore__ inline FuzzyCommitmentLdpcKernel() = default;

    __aicore__ inline void Init(
        GM_ADDR witness,
        GM_ADDR helper,
        GM_ADDR checkVariables,
        GM_ADDR variableEdges,
        GM_ADDR decoded,
        GM_ADDR decodeOk,
        GM_ADDR syndromeWeight,
        GM_ADDR iterations)
    {
        const int32_t sample = AscendC::GetBlockIdx();
        witnessGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(witness) + sample * kVariableCount,
            kVariableCount);
        helperGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(helper) + sample * kVariableCount,
            kVariableCount);
        checkVariablesGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(checkVariables),
            kEdgeCount);
        variableEdgesGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(variableEdges),
            kEdgeCount);
        decodedGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ uint16_t*>(decoded) + sample * kVariableCount,
            kVariableCount);
        decodeOkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(decodeOk) + sample, 1);
        syndromeWeightGm_.SetGlobalBuffer(
            reinterpret_cast<__gm__ int32_t*>(syndromeWeight) + sample,
            1);
        iterationsGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(iterations) + sample, 1);

        pipe_.InitBuffer(channelLlrBuffer_, kVariableCount * sizeof(float));
        pipe_.InitBuffer(qMessageBuffer_, kEdgeCount * sizeof(float));
        pipe_.InitBuffer(rMessageBuffer_, kEdgeCount * sizeof(float));
        pipe_.InitBuffer(hardDecisionBuffer_, kVariableCount * sizeof(uint16_t));
    }

    __aicore__ inline void Run()
    {
        AscendC::LocalTensor<float> channelLlr = channelLlrBuffer_.Get<float>();
        AscendC::LocalTensor<float> qMessage = qMessageBuffer_.Get<float>();
        AscendC::LocalTensor<float> rMessage = rMessageBuffer_.Get<float>();
        AscendC::LocalTensor<uint16_t> hardDecision = hardDecisionBuffer_.Get<uint16_t>();

        Initialize(channelLlr, qMessage, rMessage, hardDecision);

        int32_t syndromeWeight = kCheckCount;
        int32_t completedIterations = 0;
        for (int32_t iteration = 0; iteration < kMaxIterations; ++iteration) {
            CheckNodeUpdate(qMessage, rMessage);
            VariableNodeUpdate(channelLlr, qMessage, rMessage, hardDecision);
            syndromeWeight = ComputeSyndromeWeight(hardDecision);
            completedIterations = iteration + 1;
            if (syndromeWeight == 0) {
                break;
            }
        }

        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            decodedGm_.SetValue(variable, hardDecision.GetValue(variable));
        }
        decodeOkGm_.SetValue(0, syndromeWeight == 0 ? 1 : 0);
        syndromeWeightGm_.SetValue(0, syndromeWeight);
        iterationsGm_.SetValue(0, completedIterations);
    }

private:
    __aicore__ inline void Initialize(
        AscendC::LocalTensor<float>& channelLlr,
        AscendC::LocalTensor<float>& qMessage,
        AscendC::LocalTensor<float>& rMessage,
        AscendC::LocalTensor<uint16_t>& hardDecision)
    {
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            const uint16_t recovered = witnessGm_.GetValue(variable) ^ helperGm_.GetValue(variable);
            const float llr = recovered == 0 ? kChannelLlr : -kChannelLlr;
            channelLlr.SetValue(variable, llr);
            hardDecision.SetValue(variable, recovered);
        }

        for (int32_t edge = 0; edge < kEdgeCount; ++edge) {
            const int32_t variable = checkVariablesGm_.GetValue(edge);
            qMessage.SetValue(edge, channelLlr.GetValue(variable));
            rMessage.SetValue(edge, 0.0F);
        }
    }

    __aicore__ inline void CheckNodeUpdate(
        AscendC::LocalTensor<float>& qMessage,
        AscendC::LocalTensor<float>& rMessage)
    {
        for (int32_t check = 0; check < kCheckCount; ++check) {
            const int32_t firstEdge = check * kCheckDegree;
            float minimum = 1.0e30F;
            float secondMinimum = 1.0e30F;
            int32_t minimumIndex = -1;
            int32_t signProduct = 1;

            for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
                const int32_t edge = firstEdge + offset;
                const float value = qMessage.GetValue(edge);
                const float magnitude = value < 0.0F ? -value : value;
                const int32_t sign = value < 0.0F ? -1 : 1;
                signProduct *= sign;
                if (magnitude < minimum) {
                    secondMinimum = minimum;
                    minimum = magnitude;
                    minimumIndex = offset;
                } else if (magnitude < secondMinimum) {
                    secondMinimum = magnitude;
                }
            }

            for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
                const int32_t edge = firstEdge + offset;
                const float value = qMessage.GetValue(edge);
                const int32_t ownSign = value < 0.0F ? -1 : 1;
                const float magnitude = offset == minimumIndex ? secondMinimum : minimum;
                rMessage.SetValue(
                    edge,
                    kNormalization * static_cast<float>(signProduct * ownSign) * magnitude);
            }
        }
    }

    __aicore__ inline void VariableNodeUpdate(
        AscendC::LocalTensor<float>& channelLlr,
        AscendC::LocalTensor<float>& qMessage,
        AscendC::LocalTensor<float>& rMessage,
        AscendC::LocalTensor<uint16_t>& hardDecision)
    {
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            float total = channelLlr.GetValue(variable);
            const int32_t variableEdgeBase = variable * kVariableDegree;
            for (int32_t offset = 0; offset < kVariableDegree; ++offset) {
                const int32_t edge = variableEdgesGm_.GetValue(variableEdgeBase + offset);
                total += rMessage.GetValue(edge);
            }

            hardDecision.SetValue(variable, total < 0.0F ? 1 : 0);
            for (int32_t offset = 0; offset < kVariableDegree; ++offset) {
                const int32_t edge = variableEdgesGm_.GetValue(variableEdgeBase + offset);
                qMessage.SetValue(edge, total - rMessage.GetValue(edge));
            }
        }
    }

    __aicore__ inline int32_t ComputeSyndromeWeight(
        AscendC::LocalTensor<uint16_t>& hardDecision)
    {
        int32_t weight = 0;
        for (int32_t check = 0; check < kCheckCount; ++check) {
            uint16_t parity = 0;
            const int32_t firstEdge = check * kCheckDegree;
            for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
                const int32_t variable = checkVariablesGm_.GetValue(firstEdge + offset);
                parity ^= hardDecision.GetValue(variable);
            }
            weight += parity == 0 ? 0 : 1;
        }
        return weight;
    }

    AscendC::TPipe pipe_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> channelLlrBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> qMessageBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> rMessageBuffer_;
    AscendC::TBuf<AscendC::TPosition::VECCALC> hardDecisionBuffer_;

    AscendC::GlobalTensor<uint16_t> witnessGm_;
    AscendC::GlobalTensor<uint16_t> helperGm_;
    AscendC::GlobalTensor<int32_t> checkVariablesGm_;
    AscendC::GlobalTensor<int32_t> variableEdgesGm_;
    AscendC::GlobalTensor<uint16_t> decodedGm_;
    AscendC::GlobalTensor<int32_t> decodeOkGm_;
    AscendC::GlobalTensor<int32_t> syndromeWeightGm_;
    AscendC::GlobalTensor<int32_t> iterationsGm_;
};

struct LdpcGraph {
    std::array<int32_t, kEdgeCount> checkVariables{};
    std::array<int32_t, kEdgeCount> variableEdges{};
    std::array<std::bitset<kVariableCount>, kCheckCount> parityRows{};
    std::vector<std::bitset<kVariableCount>> nullspaceBasis;
    int32_t rank = 0;
};

struct DecodeResult {
    std::array<uint16_t, kVariableCount> bits{};
    int32_t decodeOk = 0;
    int32_t syndromeWeight = kCheckCount;
    int32_t iterations = 0;
};

LdpcGraph BuildGraph()
{
    LdpcGraph graph;
    std::array<int32_t, kVariableCount> variableEdgeCounts{};

    for (int32_t baseRow = 0; baseRow < kBaseRows; ++baseRow) {
        for (int32_t liftRow = 0; liftRow < kLiftSize; ++liftRow) {
            const int32_t check = baseRow * kLiftSize + liftRow;
            for (int32_t baseColumn = 0; baseColumn < kBaseColumns; ++baseColumn) {
                const int32_t variable =
                    baseColumn * kLiftSize +
                    (liftRow + kBaseShifts[baseRow][baseColumn]) % kLiftSize;
                const int32_t edge = check * kCheckDegree + baseColumn;
                graph.checkVariables[edge] = variable;
                graph.parityRows[check].set(variable);

                const int32_t variableOffset = variableEdgeCounts[variable]++;
                if (variableOffset >= kVariableDegree) {
                    throw std::runtime_error("invalid QC-LDPC variable degree");
                }
                graph.variableEdges[variable * kVariableDegree + variableOffset] = edge;
            }
        }
    }

    for (const int32_t count : variableEdgeCounts) {
        if (count != kVariableDegree) {
            throw std::runtime_error("incomplete QC-LDPC variable adjacency");
        }
    }

    auto reducedRows = graph.parityRows;
    std::array<int32_t, kCheckCount> pivotColumns{};
    int32_t pivotRow = 0;
    for (int32_t column = 0; column < kVariableCount && pivotRow < kCheckCount; ++column) {
        int32_t candidate = pivotRow;
        while (candidate < kCheckCount && !reducedRows[candidate].test(column)) {
            ++candidate;
        }
        if (candidate == kCheckCount) {
            continue;
        }
        std::swap(reducedRows[pivotRow], reducedRows[candidate]);
        for (int32_t row = 0; row < kCheckCount; ++row) {
            if (row != pivotRow && reducedRows[row].test(column)) {
                reducedRows[row] ^= reducedRows[pivotRow];
            }
        }
        pivotColumns[pivotRow] = column;
        ++pivotRow;
    }
    graph.rank = pivotRow;

    std::array<bool, kVariableCount> isPivot{};
    for (int32_t row = 0; row < graph.rank; ++row) {
        isPivot[pivotColumns[row]] = true;
    }
    for (int32_t freeColumn = 0; freeColumn < kVariableCount; ++freeColumn) {
        if (isPivot[freeColumn]) {
            continue;
        }
        std::bitset<kVariableCount> basisVector;
        basisVector.set(freeColumn);
        for (int32_t row = 0; row < graph.rank; ++row) {
            if (reducedRows[row].test(freeColumn)) {
                basisVector.set(pivotColumns[row]);
            }
        }
        graph.nullspaceBasis.push_back(basisVector);
    }

    return graph;
}

int32_t SyndromeWeight(
    const LdpcGraph& graph,
    const std::array<uint16_t, kVariableCount>& bits)
{
    int32_t weight = 0;
    for (int32_t check = 0; check < kCheckCount; ++check) {
        uint16_t parity = 0;
        for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
            const int32_t edge = check * kCheckDegree + offset;
            parity ^= bits[graph.checkVariables[edge]];
        }
        weight += parity == 0 ? 0 : 1;
    }
    return weight;
}

std::array<uint16_t, kVariableCount> RandomCodeword(
    const LdpcGraph& graph,
    std::mt19937& random)
{
    std::bitset<kVariableCount> codeword;
    bool selectedAny = false;
    for (const auto& basisVector : graph.nullspaceBasis) {
        if ((random() & 1U) != 0U) {
            codeword ^= basisVector;
            selectedAny = true;
        }
    }
    if (!selectedAny && !graph.nullspaceBasis.empty()) {
        codeword ^= graph.nullspaceBasis.front();
    }

    std::array<uint16_t, kVariableCount> result{};
    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        result[variable] = codeword.test(variable) ? 1 : 0;
    }
    if (SyndromeWeight(graph, result) != 0) {
        throw std::runtime_error("generated word is not an LDPC codeword");
    }
    return result;
}

DecodeResult ReferenceDecode(
    const LdpcGraph& graph,
    const std::array<uint16_t, kVariableCount>& recovered)
{
    std::array<float, kVariableCount> channelLlr{};
    std::array<float, kEdgeCount> qMessage{};
    std::array<float, kEdgeCount> rMessage{};
    DecodeResult result;

    for (int32_t variable = 0; variable < kVariableCount; ++variable) {
        channelLlr[variable] = recovered[variable] == 0 ? kChannelLlr : -kChannelLlr;
        result.bits[variable] = recovered[variable];
    }
    for (int32_t edge = 0; edge < kEdgeCount; ++edge) {
        qMessage[edge] = channelLlr[graph.checkVariables[edge]];
    }

    for (int32_t iteration = 0; iteration < kMaxIterations; ++iteration) {
        for (int32_t check = 0; check < kCheckCount; ++check) {
            const int32_t firstEdge = check * kCheckDegree;
            float minimum = 1.0e30F;
            float secondMinimum = 1.0e30F;
            int32_t minimumIndex = -1;
            int32_t signProduct = 1;
            for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
                const float value = qMessage[firstEdge + offset];
                const float magnitude = value < 0.0F ? -value : value;
                const int32_t sign = value < 0.0F ? -1 : 1;
                signProduct *= sign;
                if (magnitude < minimum) {
                    secondMinimum = minimum;
                    minimum = magnitude;
                    minimumIndex = offset;
                } else if (magnitude < secondMinimum) {
                    secondMinimum = magnitude;
                }
            }
            for (int32_t offset = 0; offset < kCheckDegree; ++offset) {
                const int32_t edge = firstEdge + offset;
                const int32_t ownSign = qMessage[edge] < 0.0F ? -1 : 1;
                const float magnitude = offset == minimumIndex ? secondMinimum : minimum;
                rMessage[edge] =
                    kNormalization * static_cast<float>(signProduct * ownSign) * magnitude;
            }
        }

        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            float total = channelLlr[variable];
            for (int32_t offset = 0; offset < kVariableDegree; ++offset) {
                const int32_t edge = graph.variableEdges[variable * kVariableDegree + offset];
                total += rMessage[edge];
            }
            result.bits[variable] = total < 0.0F ? 1 : 0;
            for (int32_t offset = 0; offset < kVariableDegree; ++offset) {
                const int32_t edge = graph.variableEdges[variable * kVariableDegree + offset];
                qMessage[edge] = total - rMessage[edge];
            }
        }

        result.syndromeWeight = SyndromeWeight(graph, result.bits);
        result.iterations = iteration + 1;
        if (result.syndromeWeight == 0) {
            result.decodeOk = 1;
            break;
        }
    }
    return result;
}

std::array<uint8_t, kVariableCount> SerializeBits(
    const std::array<uint16_t, kVariableCount>& bits)
{
    std::array<uint8_t, kVariableCount> bytes{};
    for (int32_t index = 0; index < kVariableCount; ++index) {
        bytes[index] = static_cast<uint8_t>(bits[index]);
    }
    return bytes;
}

void CheckAcl(aclError code, const std::string& operation)
{
    if (code != ACL_SUCCESS) {
        std::cerr << "[FAIL] " << operation << " returned ACL error " << code << std::endl;
        std::exit(EXIT_FAILURE);
    }
}

template <typename T>
T* AllocateDevice(std::size_t elementCount, const std::string& name)
{
    T* pointer = nullptr;
    CheckAcl(
        aclrtMalloc(
            reinterpret_cast<void**>(&pointer),
            elementCount * sizeof(T),
            ACL_MEM_MALLOC_HUGE_FIRST),
        "aclrtMalloc(" + name + ")");
    return pointer;
}

template <typename T>
void CopyHostToDevice(T* device, const T* host, std::size_t elementCount, const std::string& name)
{
    const std::size_t bytes = elementCount * sizeof(T);
    CheckAcl(aclrtMemcpy(device, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy " + name);
}

template <typename T>
void CopyDeviceToHost(T* host, const T* device, std::size_t elementCount, const std::string& name)
{
    const std::size_t bytes = elementCount * sizeof(T);
    CheckAcl(aclrtMemcpy(host, bytes, device, bytes, ACL_MEMCPY_DEVICE_TO_HOST), "copy " + name);
}

} // namespace

__global__ __vector__ void fuzzy_commitment_ldpc_recover(
    GM_ADDR witness,
    GM_ADDR helper,
    GM_ADDR checkVariables,
    GM_ADDR variableEdges,
    GM_ADDR decoded,
    GM_ADDR decodeOk,
    GM_ADDR syndromeWeight,
    GM_ADDR iterations)
{
    FuzzyCommitmentLdpcKernel kernel;
    kernel.Init(
        witness,
        helper,
        checkVariables,
        variableEdges,
        decoded,
        decodeOk,
        syndromeWeight,
        iterations);
    kernel.Run();
}

int main()
{
    const LdpcGraph graph = BuildGraph();
    const int32_t dimension = kVariableCount - graph.rank;
    std::cout << "QC-LDPC parameters: N=" << kVariableCount
              << " K=" << dimension
              << " M=" << kCheckCount
              << " edges=" << kEdgeCount << std::endl;

    std::array<uint16_t, kBatchSize * kVariableCount> witness{};
    std::array<uint16_t, kBatchSize * kVariableCount> helper{};
    std::array<std::array<uint16_t, kVariableCount>, kBatchSize> enrolledWitness{};
    std::array<std::array<uint16_t, kVariableCount>, kBatchSize> originalCodewords{};
    std::array<std::array<uint8_t, kFuzzyCommitmentSha256Bytes>, kBatchSize> commitmentTags{};
    std::array<DecodeResult, kBatchSize> referenceResults{};
    std::array<int32_t, kBatchSize> bitErrors{};
    std::array<bool, kBatchSize> expectedAccept{};
    constexpr std::array<int32_t, 8> kPositiveErrorCounts = {0, 1, 1, 2, 2, 3, 3, 3};

    std::mt19937 random(0xC0DE900U);
    for (int32_t sample = 0; sample < kBatchSize; ++sample) {
        originalCodewords[sample] = RandomCodeword(graph, random);
        auto& enrolled = enrolledWitness[sample];
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            enrolled[variable] = static_cast<uint16_t>(random() & 1U);
            helper[sample * kVariableCount + variable] =
                enrolled[variable] ^ originalCodewords[sample][variable];
            witness[sample * kVariableCount + variable] = enrolled[variable];
        }

        if (sample < 8) {
            expectedAccept[sample] = true;
            bitErrors[sample] = kPositiveErrorCounts[sample];
            for (int32_t error = 0; error < bitErrors[sample]; ++error) {
                const int32_t position = (sample * 11 + error * 29 + 7) % kVariableCount;
                witness[sample * kVariableCount + position] ^= 1;
            }
        } else {
            expectedAccept[sample] = false;
            bitErrors[sample] = 0;
            for (int32_t variable = 0; variable < kVariableCount; ++variable) {
                const uint16_t impostorBit = static_cast<uint16_t>(random() & 1U);
                witness[sample * kVariableCount + variable] = impostorBit;
                bitErrors[sample] += impostorBit == enrolled[variable] ? 0 : 1;
            }
        }

        std::array<uint16_t, kVariableCount> recovered{};
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            recovered[variable] =
                witness[sample * kVariableCount + variable] ^
                helper[sample * kVariableCount + variable];
        }
        referenceResults[sample] = ReferenceDecode(graph, recovered);

        if (expectedAccept[sample] &&
            (referenceResults[sample].decodeOk == 0 ||
             referenceResults[sample].bits != originalCodewords[sample])) {
            std::cerr << "[FAIL] reference decoder could not recover positive case " << sample
                      << std::endl;
            return EXIT_FAILURE;
        }

        const auto serialized = SerializeBits(originalCodewords[sample]);
        commitmentTags[sample] = FuzzyCommitmentSha256(serialized.data(), serialized.size());
    }

    CheckAcl(aclInit(nullptr), "aclInit");
    CheckAcl(aclrtSetDevice(0), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream");

    uint16_t* witnessDevice = AllocateDevice<uint16_t>(witness.size(), "witness");
    uint16_t* helperDevice = AllocateDevice<uint16_t>(helper.size(), "helper");
    int32_t* checkVariablesDevice =
        AllocateDevice<int32_t>(graph.checkVariables.size(), "checkVariables");
    int32_t* variableEdgesDevice =
        AllocateDevice<int32_t>(graph.variableEdges.size(), "variableEdges");
    uint16_t* decodedDevice =
        AllocateDevice<uint16_t>(kBatchSize * kVariableCount, "decoded");
    int32_t* decodeOkDevice = AllocateDevice<int32_t>(kBatchSize, "decodeOk");
    int32_t* syndromeWeightDevice = AllocateDevice<int32_t>(kBatchSize, "syndromeWeight");
    int32_t* iterationsDevice = AllocateDevice<int32_t>(kBatchSize, "iterations");

    CopyHostToDevice(witnessDevice, witness.data(), witness.size(), "witness");
    CopyHostToDevice(helperDevice, helper.data(), helper.size(), "helper");
    CopyHostToDevice(
        checkVariablesDevice,
        graph.checkVariables.data(),
        graph.checkVariables.size(),
        "checkVariables");
    CopyHostToDevice(
        variableEdgesDevice,
        graph.variableEdges.data(),
        graph.variableEdges.size(),
        "variableEdges");

    fuzzy_commitment_ldpc_recover<<<kBatchSize, nullptr, stream>>>(
        reinterpret_cast<uint8_t*>(witnessDevice),
        reinterpret_cast<uint8_t*>(helperDevice),
        reinterpret_cast<uint8_t*>(checkVariablesDevice),
        reinterpret_cast<uint8_t*>(variableEdgesDevice),
        reinterpret_cast<uint8_t*>(decodedDevice),
        reinterpret_cast<uint8_t*>(decodeOkDevice),
        reinterpret_cast<uint8_t*>(syndromeWeightDevice),
        reinterpret_cast<uint8_t*>(iterationsDevice));
    CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream");

    std::array<uint16_t, kBatchSize * kVariableCount> decoded{};
    std::array<int32_t, kBatchSize> decodeOk{};
    std::array<int32_t, kBatchSize> syndromeWeight{};
    std::array<int32_t, kBatchSize> iterations{};
    CopyDeviceToHost(decoded.data(), decodedDevice, decoded.size(), "decoded");
    CopyDeviceToHost(decodeOk.data(), decodeOkDevice, decodeOk.size(), "decodeOk");
    CopyDeviceToHost(
        syndromeWeight.data(),
        syndromeWeightDevice,
        syndromeWeight.size(),
        "syndromeWeight");
    CopyDeviceToHost(iterations.data(), iterationsDevice, iterations.size(), "iterations");

    int32_t passedCases = 0;
    for (int32_t sample = 0; sample < kBatchSize; ++sample) {
        std::array<uint16_t, kVariableCount> decodedCodeword{};
        for (int32_t variable = 0; variable < kVariableCount; ++variable) {
            decodedCodeword[variable] = decoded[sample * kVariableCount + variable];
        }
        const auto serialized = SerializeBits(decodedCodeword);
        const auto recoveredTag = FuzzyCommitmentSha256(serialized.data(), serialized.size());
        const bool authenticated =
            FuzzyCommitmentConstantTimeDigestEqual(recoveredTag, commitmentTags[sample]);
        const bool matchesReference = decodedCodeword == referenceResults[sample].bits;
        const bool metadataMatches =
            decodeOk[sample] == referenceResults[sample].decodeOk &&
            syndromeWeight[sample] == referenceResults[sample].syndromeWeight &&
            iterations[sample] == referenceResults[sample].iterations;
        const bool passed =
            matchesReference && metadataMatches && authenticated == expectedAccept[sample];
        passedCases += passed ? 1 : 0;

        std::cout << (passed ? "[PASS]" : "[FAIL]")
                  << "[CASE_" << std::setw(2) << std::setfill('0') << sample << std::setfill(' ')
                  << "] type=" << (expectedAccept[sample] ? "legitimate" : "impostor")
                  << " bit_errors=" << bitErrors[sample]
                  << " syndrome=" << syndromeWeight[sample]
                  << " iterations=" << iterations[sample]
                  << " authenticated=" << (authenticated ? "yes" : "no")
                  << " reference_match=" << (matchesReference ? "yes" : "no")
                  << std::endl;
    }

    CheckAcl(aclrtFree(witnessDevice), "aclrtFree(witness)");
    CheckAcl(aclrtFree(helperDevice), "aclrtFree(helper)");
    CheckAcl(aclrtFree(checkVariablesDevice), "aclrtFree(checkVariables)");
    CheckAcl(aclrtFree(variableEdgesDevice), "aclrtFree(variableEdges)");
    CheckAcl(aclrtFree(decodedDevice), "aclrtFree(decoded)");
    CheckAcl(aclrtFree(decodeOkDevice), "aclrtFree(decodeOk)");
    CheckAcl(aclrtFree(syndromeWeightDevice), "aclrtFree(syndromeWeight)");
    CheckAcl(aclrtFree(iterationsDevice), "aclrtFree(iterations)");
    CheckAcl(aclrtDestroyStream(stream), "aclrtDestroyStream");
    CheckAcl(aclrtResetDevice(0), "aclrtResetDevice");
    CheckAcl(aclFinalize(), "aclFinalize");

    if (passedCases != kBatchSize) {
        std::cerr << "[FAIL] Fuzzy commitment CANN test passed " << passedCases
                  << "/" << kBatchSize << " cases." << std::endl;
        return EXIT_FAILURE;
    }

    std::cout << "[PASS] Fuzzy commitment CANN test passed " << passedCases
              << "/" << kBatchSize << " cases." << std::endl;
    return EXIT_SUCCESS;
}
